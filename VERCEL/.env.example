# =================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (SEGURO PARA GIT)
# Copia este archivo a `.env.local` y asigna tus credenciales reales.
# Comando: cp .env.example .env.local
# =================================================================

# -------------------------------------------------------------
# 1. BASE DE DATOS: TURSO (libSQL / SQLite Distribuido)
# -------------------------------------------------------------
# URL del cluster de Turso (formato: libsql://nombre.region.turso.io)
TURSO_DATABASE_URL="libsql://tu-base-de-datos.aws-us-east-2.turso.io"

# Token JWT emitido por Turso para lectura/escritura
TURSO_AUTH_TOKEN="tu_turso_jwt_token_aqui"

# -------------------------------------------------------------
# 2. ALMACENAMIENTO DE ARCHIVOS: CLOUDFLARE R2 (S3 Compatible)
# -------------------------------------------------------------
# ID de cuenta de Cloudflare (32 caracteres hexadecimales)
R2_ACCOUNT_ID="tu_cloudflare_account_id"

# Credenciales de cliente S3 generadas en Cloudflare R2 API Tokens
R2_ACCESS_KEY_ID="tu_r2_access_key_id"
R2_SECRET_ACCESS_KEY="tu_r2_secret_access_key"

# Nombre del bucket en Cloudflare R2
R2_BUCKET_NAME="control-estudios"

# Endpoint S3 de Cloudflare para tu cuenta
R2_ENDPOINT="https://tu_cloudflare_account_id.r2.cloudflarestorage.com"

# URL pública o dominio personalizado para servir imágenes y soportes
R2_PUBLIC_URL="https://pub-ejemplo.r2.dev"

# Token opcional de API de Cloudflare
CF_API_TOKEN="cfat_ejemplo"

# -------------------------------------------------------------
# 3. SEGURIDAD Y APLICACIÓN
# -------------------------------------------------------------
# URL base de la aplicación (en local o producción)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secreto para firma de sesiones y tokens (mínimo 32 caracteres)
AUTH_SECRET="genera_un_secreto_seguro_con_openssl_rand_hex_32"

# -------------------------------------------------------------
# 4. ENVÍO DE CORREOS ELECTRÓNICOS
# -------------------------------------------------------------
# Proveedor: "smtp" (Gmail u otro) o "resend" (API recomendada)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="tls"
SMTP_FROM_NAME="UPTPC - Control de Estudios"

# Si usas Resend:
# RESEND_API_KEY="re_123456789"
